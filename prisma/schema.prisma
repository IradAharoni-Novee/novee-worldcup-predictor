// Prisma schema for the World Cup 2026 Match Predictor.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// Auth.js core tables — see https://authjs.dev/getting-started/adapters/prisma

model User {
  id                         String                      @id @default(cuid())
  email                      String                      @unique
  name                       String?
  emailVerified              DateTime?
  image                      String?
  passwordHash               String?
  isAdmin                    Boolean                     @default(false)
  createdAt                  DateTime                    @default(now())
  // Self-FK: pick a colleague as your nemesis. /me surfaces an H2H delta.
  nemesisId                  String?
  nemesis                    User?                       @relation("UserNemesis", fields: [nemesisId], references: [id], onDelete: SetNull)
  enemyOf                    User[]                      @relation("UserNemesis")
  accounts                   Account[]
  sessions                   Session[]
  predictions                Prediction[]
  groupPredictions           GroupPrediction[]
  bracketPicks               BracketPick[]
  winnerPrediction           TournamentWinnerPrediction?
  goldenBootPrediction       GoldenBootPrediction?
  thirdPlaceQualifierPicks   ThirdPlaceQualifierPick[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Domain models

enum Stage {
  GROUP
  R32
  R16
  QF
  SF
  THIRD
  FINAL
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
}

model Team {
  id        String  @id @default(cuid())
  fdId      Int     @unique
  name      String
  code      String  @unique
  flag      String?
  homeMatches Match[] @relation("HomeTeam")
  awayMatches Match[] @relation("AwayTeam")
  groupPicks1st GroupPrediction[] @relation("GroupPick1st")
  groupPicks2nd GroupPrediction[] @relation("GroupPick2nd")
  groupPicks3rd GroupPrediction[] @relation("GroupPick3rd")
  groupPicks4th GroupPrediction[] @relation("GroupPick4th")
  bracketPicks  BracketPick[]     @relation("BracketPickTeam")
  winnerPicks   TournamentWinnerPrediction[] @relation("WinnerPickTeam")
  thirdPlaceQualifiers ThirdPlaceQualifierPick[] @relation("ThirdPlaceQualifierTeam")
  players       Player[]
}

model Player {
  id          String  @id @default(cuid())
  fdId        Int?    @unique
  name        String
  position    String?
  dateOfBirth String?
  nationality String?
  photo       String?
  fifaName    String?
  teamId      String?
  team        Team?   @relation(fields: [teamId], references: [id])
  goldenBootPicks GoldenBootPrediction[] @relation("GoldenBootPickPlayer")

  @@index([teamId])
  @@index([position])
}

model Match {
  id         String      @id @default(cuid())
  fdId       Int         @unique
  stage      Stage
  group      String?
  kickoff    DateTime
  venue      String?
  city       String?
  country    String?
  homeTeamId String?
  awayTeamId String?
  homeScore  Int?
  awayScore  Int?
  status     MatchStatus @default(SCHEDULED)
  updatedAt  DateTime    @updatedAt

  homeTeam    Team?        @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam    Team?        @relation("AwayTeam", fields: [awayTeamId], references: [id])
  predictions Prediction[]

  @@index([kickoff])
  @@index([stage])
}

model Prediction {
  id          String   @id @default(cuid())
  userId      String
  matchId     String
  homeScore   Int
  awayScore   Int
  // Optional 80-char "hot take" attached to the prediction. Revealed
  // retroactively on /me and on the match detail page after kickoff.
  note        String?
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([matchId])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// One materialised leaderboard per day. Match results are updated in place, so
// a past day's standings can't be recomputed after the fact — they're captured
// here by the daily reminder cron and served back through ?d= on the card.
model LeaderboardSnapshot {
  date      String   @id // "YYYY-MM-DD" (UTC), matches the reminder cron's dateKey
  data      Json // full LeaderboardRow[] as computed by getLeaderboard()
  createdAt DateTime @default(now())
}

model GroupPrediction {
  id          String   @id @default(cuid())
  userId      String
  group       String
  team1stId   String
  team2ndId   String
  team3rdId   String
  team4thId   String
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team1st Team @relation("GroupPick1st", fields: [team1stId], references: [id])
  team2nd Team @relation("GroupPick2nd", fields: [team2ndId], references: [id])
  team3rd Team @relation("GroupPick3rd", fields: [team3rdId], references: [id])
  team4th Team @relation("GroupPick4th", fields: [team4thId], references: [id])

  @@unique([userId, group])
  @@index([group])
}

model BracketPick {
  id          String   @id @default(cuid())
  userId      String
  round       Stage
  slot        Int
  teamId      String
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation("BracketPickTeam", fields: [teamId], references: [id])

  @@unique([userId, round, slot])
  @@index([userId, round])
}

model TournamentWinnerPrediction {
  id          String   @id @default(cuid())
  userId      String   @unique
  teamId      String
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation("WinnerPickTeam", fields: [teamId], references: [id])
}

model GoldenBootPrediction {
  id          String   @id @default(cuid())
  userId      String   @unique
  playerId    String
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  player Player @relation("GoldenBootPickPlayer", fields: [playerId], references: [id])

  @@index([playerId])
}

model ThirdPlaceQualifierPick {
  id          String   @id @default(cuid())
  userId      String
  teamId      String
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation("ThirdPlaceQualifierTeam", fields: [teamId], references: [id])

  @@unique([userId, teamId])
  @@index([userId])
}

// CTF — intentionally isolated from the predictor domain. No FKs to Prediction,
// BracketPick, Setting, or any scoring surface. Code paths that touch these
// tables are append-only: users can create CtfCapture rows but never update or
// delete anything in either table from a web action.

model CtfFlag {
  id             String       @id @default(cuid())
  slug           String       @unique
  code           String       @unique
  points         Int          @default(10)
  hint           String
  discoveryHint  String
  createdAt      DateTime     @default(now())
  captures       CtfCapture[]
}

model CtfCapture {
  id         String   @id @default(cuid())
  userId     String
  flagId     String
  capturedAt DateTime @default(now())

  flag CtfFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@unique([userId, flagId])
  @@index([userId])
  @@index([flagId])
}
