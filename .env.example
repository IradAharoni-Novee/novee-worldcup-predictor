# Postgres connection (Neon, or local). Required.
DATABASE_URL="postgresql://user:pass@host:5432/dbname?sslmode=require"

# Auth.js secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Resend API key (magic-link emails). Required.
RESEND_API_KEY=""
AUTH_EMAIL_FROM="Match Predictor <noreply@yourdomain.com>"

# football-data.org API token. Free tier: https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=""

# Cron secret. Generate with: openssl rand -hex 32
CRON_SECRET=""

# Slack bot token (xoxb-...) for fetching profile pictures at first sign-in.
# Needs scopes: users:read, users:read.email. Optional — leave empty to skip Slack lookup.
SLACK_BOT_TOKEN=""
# Comma-separated list of email domains to try in Slack if the sign-in email isn't
# found. Useful when the sign-in domain (e.g., novee.security) differs from the
# Slack workspace domain (e.g., novee.io). We'll try local-part@<each-domain>.
SLACK_EMAIL_DOMAINS=""
